{
  "name": "webgl-plot",
  "version": "1.1.1",
  "description": "High-performance 2D plotting library based on native WebGL",
  "main": "./dist/webglplot.umd.js",
  "module": "./dist/webglplot.mjs",
  "exports": {
    ".": {
      "types": "./dist/webglplot.d.ts",
      "require": "./dist/webglplot.umd.js",
      "import": "./dist/webglplot.mjs"
    }
  },
  "keywords": [
    "webgl",
    "plot",
    "realtime",
    "opengl",
    "2d",
    "high-performance"
  ],
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.2.1",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "typedoc": "^0.28.9",
    "typedoc-plugin-markdown": "^4.8.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && eslint",
    "test:html": "vite -c benchmark/vite.config.mts",
    "build:test": "vite build -c benchmark/vite.config.mts",
    "doc": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danchitnis/webgl-plot.git"
  },
  "author": "Danial Chitnis",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danchitnis/webgl-plot/issues"
  },
  "homepage": "https://github.com/danchitnis/webgl-plot"
}
